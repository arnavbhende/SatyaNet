{
  "name": "satyanet-monorepo",
  "version": "2.0.0",
  "description": "SatyaNet - AI-powered misinformation detection platform",
  "private": true,
  "workspaces": [
    "satyanet-frontend"
  ],
  "scripts": {
    "build": "chmod +x build-with-npm.sh && ./build-with-npm.sh",
    "build:windows": ".\\build-with-npm.bat",
    "dev": "cd satyanet-frontend && npm run dev",
    "start": "cd satyanet-frontend && npm start",
    "render-build": "chmod +x build-with-npm.sh && ./build-with-npm.sh"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "packageManager": "npm@9.8.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/arnavbhende/SatyaNet.git"
  },
  "author": "Arnav Bhende",
  "license": "MIT"
}